import wollok.game.*
import personajes.*
import armamento.*
import escenario.*
import dinero.*

program juego {
	game.title("Untitled Game")
	game.height(20)
	game.width(20)
	game.cellSize(50)

	// Prueba de generacion dinamica de paredes
	const paredesDerecha = (0..19).map( {i => new Pared(position = game.at(19, i))} )
	paredesDerecha.forEach({ pared => game.addVisual(pared) })

	game.addVisual(camion)

	keyboard.w().onPressDo({ ladron.moverseArriba() })
	keyboard.s().onPressDo({ ladron.moverseAbajo() })
	keyboard.a().onPressDo({ ladron.moverseIzquierda() })
	keyboard.d().onPressDo({ ladron.moverseDerecha() })

	//up down left right son las flechas del teclado

	keyboard.up().onPressDo({ policia.moverseArriba() })
	keyboard.down().onPressDo({ policia.moverseAbajo() })		
	keyboard.left().onPressDo({ policia.moverseIzquierda() })
	keyboard.right().onPressDo({ policia.moverseDerecha() }) 

	//dinero de prueba
	const agregarDinero = { dinero =>
		game.addVisual(dinero)
		game.onCollideDo(dinero, { personaje => personaje.chocarConDinero(dinero) })
	}
	agregarDinero.apply(new Moneda(position = game.at(5, 5)))
	agregarDinero.apply(new Moneda(position = game.at(7, 5)))
	agregarDinero.apply(new BolsaDeDinero(position = game.at(9, 5)))
	agregarDinero.apply(new Diamante(position = game.at(11, 5)))

	// Armas de prueba 
	const agregarArma = { arma => 
		game.addVisual(arma)
		game.onCollideDo(arma, { policia => policia.tomarArma(arma) })
	}
	agregarArma.apply(new Pistola(position = game.at(5,6)))

	//policia y ladron se agrega despues del dinero para al pasar arriba del dinero aparezca el policia o ladron arriba del dinero y no al reves
	game.addVisual(policia)
	game.addVisual(ladron)

	//Colision con paredes
	game.onCollideDo(ladron, { objetoMapa  =>
		if (!objetoMapa.sePuedeAtravesarLadron()) {
			ladron.retroceder()
		}
	})

	game.onCollideDo(camion, { personaje => personaje.chocarConCamion(camion) })

	game.onCollideDo(policia, { objetoMapa  =>
		if (!objetoMapa.sePuedeAtravesarPolicia()) {
			policia.retroceder()
		}
	})


	game.start()
}
