import wollok.game.*

import ladron.*
import policia.*
import municion.*
import proyectil.*
import direcciones.*
import dinero.*
import banco.*
import escenario.*
import hud.*
import armas.*
import mapa.*

describe "Entrega 1" {

  var pared
  var moneda
  var bolsa
  var arma
  var proyectil

  method initialize() {
    ladron.position(game.at(0, 1))
    policia.position(game.at(18, 10))
    ladron.direccion(abajo)
    policia.direccion(abajo)
  }

  test "arriba calcula la celda siguiente" {
    const origen = game.at(3, 4)

    const destino = arriba.siguientePosicion(origen)

    assert.equals(game.at(3, 5), destino)
  }

  test "abajo calcula la celda siguiente" {
    const origen = game.at(3, 4)

    const destino = abajo.siguientePosicion(origen)

    assert.equals(game.at(3, 3), destino)
  }

  test "izquierda calcula la celda siguiente" {
    const origen = game.at(3, 4)

    const destino = izquierda.siguientePosicion(origen)

    assert.equals(game.at(2, 4), destino)
  }

  test "derecha calcula la celda siguiente" {
    const origen = game.at(3, 4)

    const destino = derecha.siguientePosicion(origen)

    assert.equals(game.at(4, 4), destino)
  }

  test "el policía se mueve hacia arriba usando la dirección correspondiente" {
    policia.position(game.at(8, 8))

    policia.moverseArriba()

    assert.equals(game.at(8, 9), policia.position())
    assert.equals(arriba, policia.direccion())
  }

  test "el policía se mueve hacia abajo usando la dirección correspondiente" {
    policia.position(game.at(8, 8))

    policia.moverseAbajo()

    assert.equals(game.at(8, 7), policia.position())
    assert.equals(abajo, policia.direccion())
  }

  test "el policía se mueve hacia la izquierda usando la dirección correspondiente" {
    policia.position(game.at(8, 8))

    policia.moverseIzquierda()

    assert.equals(game.at(7, 8), policia.position())
    assert.equals(izquierda, policia.direccion())
  }

  test "el policía se mueve hacia la derecha usando la dirección correspondiente" {
    policia.position(game.at(8, 8))

    policia.moverseDerecha()

    assert.equals(game.at(9, 8), policia.position())
    assert.equals(derecha, policia.direccion())
  }

  test "la celda destino del ladrón se valida antes de moverse" {
    pared = new Pared(position = game.at(2, 4))
    game.addVisual(pared)
    ladron.position(game.at(2, 3))

    const destinoBloqueado = game.at(2, 4)
    const destinoLibre = game.at(2, 2)

    assert.notThat(ladron.celdaLibre(destinoBloqueado))
    assert.that(ladron.celdaLibre(destinoLibre))
  }

  test "el policía puede moverse y no pisa una pared" {
    pared = new Pared(position = game.at(8, 8))
    game.addVisual(pared)
    policia.position(game.at(8, 7))

    policia.moverseAbajo()

    assert.equals(game.at(8, 6), policia.position())
    assert.notThat(policia.celdaLibre(game.at(8, 8)))
    assert.equals(abajo, policia.direccion())
  }

  test "el ladrón puede cargar una moneda" {
    moneda = new Moneda(position = game.at(1, 8))
    banco.agregar(moneda)
    ladron.position(game.at(1, 8))

    moneda.serRecogidoPor(ladron)

    assert.that(banco.sinDinero())
    ladron.entregarCargaA(camion)
    assert.equals(10, puntaje.puntos())
    banco.vaciar()
  }

  test "el camión recibe la carga del ladrón" {
    moneda = new Moneda(position = game.at(1, 8))
    banco.agregar(moneda)
    ladron.position(game.at(1, 8))
    moneda.serRecogidoPor(ladron)
    const puntosAntes = puntaje.puntos()

    ladron.entregarCargaA(camion)

    assert.equals(puntosAntes + 10, puntaje.puntos())
    banco.vaciar()
  }

  test "el ladrón puede cargar una bolsa y entregarla" {
    bolsa = new BolsaDeDinero(position = game.at(5, 9))
    banco.agregar(bolsa)
    ladron.position(game.at(5, 9))

    bolsa.serRecogidoPor(ladron)
    const puntosAntes = puntaje.puntos()

    ladron.entregarCargaA(camion)
    assert.equals(puntosAntes + 100, puntaje.puntos())
    banco.vaciar()
  }

  test "el policía puede disparar con su arma actual" {
    arma = new Pistola()
    policia.position(game.at(10, 10))
    policia.tomarArma(arma)

    policia.disparar()

    assert.equals(6, arma.balasEnCargador())
  }

  test "la munición recarga el arma del policía" {
    arma = new Pistola()
    policia.position(game.at(12, 12))
    policia.tomarArma(arma)
    policia.disparar()

    new Municion().serRecogidaPor(policia)

    assert.equals(7, arma.balasEnCargador())
  }

  test "el proyectil le quita una vida al ladrón al impactar" {
    proyectil = new Proyectil(position = game.at(4, 4), direccion = arriba, danioProyectil = 1)
    const vidasAntes = ladron.vidasRestantes()

    ladron.recibirImpactoDe(proyectil)

    assert.equals(vidasAntes - 1, ladron.vidasRestantes())
  }

    test "el proyectil le quita dos vidas al ladrón al impactar" {
    proyectil = new Proyectil(position = game.at(4, 4), direccion = arriba, danioProyectil = 2)
    const vidasAntes = ladron.vidasRestantes()

    ladron.recibirImpactoDe(proyectil)

    assert.equals(vidasAntes - 2, ladron.vidasRestantes())
  }
}

describe "Entrega 2" {

  var murio = false

  //los objetos del juego son unicos: antes de cada test se deja todo como al empezar
  method initialize() {
    banco.vaciar()
    ladron.reiniciar()
    policia.reiniciar()
    puntaje.reiniciar()
    murio = false
    ladron.alMorir({ murio = true })
  }

  // ---- banco

  test "las celdas del banco no se repiten ni caen sobre paredes" {
    const celdasDeDinero = banco.celdasDeMonedas() + banco.celdasDeBolsas() + banco.celdasDeDiamantes()
    const celdasDeParedes = mapa.celdasDeParedes().map({ c => banco.celda(c.get(0), c.get(1)) })

    assert.equals(celdasDeDinero.size(), celdasDeDinero.asSet().size())
    assert.that(celdasDeDinero.all({ celda => not celdasDeParedes.contains(celda) }))
  }

  test "reponer agrega dinero en todas las celdas del banco" {
    const celdasDeDinero = banco.celdasDeMonedas() + banco.celdasDeBolsas() + banco.celdasDeDiamantes()

    banco.reponer()

    assert.notThat(banco.sinDinero())
    assert.that(celdasDeDinero.all({ celda => game.getObjectsIn(celda).size() == 1 }))
    banco.vaciar()
  }

  test "retirar saca el dinero del banco y del mapa" {
    const moneda = new Moneda(position = game.at(10, 15))
    banco.agregar(moneda)

    banco.retirar(moneda)

    assert.that(banco.sinDinero())
    assert.that(game.getObjectsIn(game.at(10, 15)).isEmpty())
  }

  test "una entrega no repone el dinero si todavia queda en el mapa" {
    banco.agregar(new Moneda(position = game.at(10, 15)))

    banco.entregaRealizada()

    assert.that(game.getObjectsIn(banco.celda(19, 17)).isEmpty())
    banco.vaciar()
  }

  test "la entrega del ultimo dinero repone el banco" {
    const moneda = new Moneda(position = game.at(10, 15))
    banco.agregar(moneda)
    moneda.serRecogidoPor(ladron)

    ladron.entregarCargaA(camion)

    assert.notThat(banco.sinDinero())
    banco.vaciar()
  }

  // ---- dinero y entrega

  test "cada tipo de dinero vale lo que corresponde" {
    assert.equals(10, new Moneda().valor())
    assert.equals(100, new BolsaDeDinero().valor())
    assert.equals(500, new Diamante().valor())
  }

  test "el ladron con las manos ocupadas no recoge mas dinero" {
    const primera = new Moneda(position = game.at(10, 15))
    const segunda = new Moneda(position = game.at(11, 15))
    banco.agregar(primera)
    banco.agregar(segunda)
    primera.serRecogidoPor(ladron)

    segunda.serRecogidoPor(ladron)

    assert.notThat(banco.sinDinero())
    assert.that(game.getObjectsIn(game.at(11, 15)).contains(segunda))
    banco.vaciar()
  }

  test "al entregar la carga el ladron queda con las manos vacias" {
    const moneda = new Moneda(position = game.at(10, 15))
    banco.agregar(moneda)
    banco.agregar(new Moneda(position = game.at(11, 15)))
    moneda.serRecogidoPor(ladron)
    ladron.entregarCargaA(camion)

    ladron.entregarCargaA(camion)

    assert.equals(10, puntaje.puntos())
    banco.vaciar()
  }

  test "despues de entregar el ladron puede cargar otro dinero" {
    const primera = new Moneda(position = game.at(10, 15))
    const segunda = new BolsaDeDinero(position = game.at(11, 15))
    banco.agregar(primera)
    banco.agregar(segunda)
    primera.serRecogidoPor(ladron)
    ladron.entregarCargaA(camion)

    segunda.serRecogidoPor(ladron)
    ladron.entregarCargaA(camion)

    assert.equals(110, puntaje.puntos())
    banco.vaciar()
  }

  test "el ladron con las manos ocupadas conserva su carga" {
    const moneda = new Moneda(position = game.at(10, 15))
    const diamante = new Diamante(position = game.at(11, 15))
    banco.agregar(moneda)
    banco.agregar(diamante)
    moneda.serRecogidoPor(ladron)
    diamante.serRecogidoPor(ladron)

    ladron.entregarCargaA(camion)

    assert.equals(10, puntaje.puntos())
    banco.vaciar()
  }

  test "entregar sin carga no suma puntos" {
    ladron.entregarCargaA(camion)

    assert.equals(0, puntaje.puntos())
    assert.that(banco.sinDinero())
  }

  test "el policia no atraviesa el camion pero el ladron si" {
    game.addVisual(camion)

    assert.notThat(policia.celdaLibre(camion.position()))
    assert.that(ladron.celdaLibre(camion.position()))
    game.removeVisual(camion)
  }

  test "el ladron y el policia no se atraviesan" {
    game.addVisual(ladron)
    game.addVisual(policia)
    ladron.position(game.at(5, 5))
    policia.position(game.at(5, 6))

    assert.notThat(ladron.celdaLibre(policia.position()))
    assert.notThat(policia.celdaLibre(ladron.position()))
    game.removeVisual(ladron)
    game.removeVisual(policia)
  }

  // ---- vidas y reinicio

  test "el ladron muere al quedarse sin vidas" {
    ladron.recibirDisparo(3)

    assert.equals(0, ladron.vidasRestantes())
    assert.that(murio)
  }

  test "el ladron no muere mientras le queden vidas" {
    ladron.recibirDisparo(2)

    assert.equals(1, ladron.vidasRestantes())
    assert.notThat(murio)
  }

  test "reiniciar devuelve a los personajes a su posicion inicial y al ladron sus vidas" {
    ladron.recibirDisparo(1)
    ladron.position(game.at(7, 7))
    policia.position(game.at(7, 8))

    ladron.reiniciar()
    policia.reiniciar()

    assert.equals(3, ladron.vidasRestantes())
    assert.equals(game.at(1, 1), ladron.position())
    assert.equals(game.at(18, 1), policia.position())
  }

  test "la imagen de los personajes depende de hacia donde miran" {
    ladron.direccion(izquierda)
    policia.direccion(arriba)

    assert.equals("ladronIzquierda.png", ladron.image())
    assert.equals("policiaArriba.png", policia.image())
  }

  // ---- armas y proyectiles

  test "el danio del proyectil depende del arma" {
    policia.tomarArma(new Pistola())
    policia.disparar()
    const proyectilDePistola = game.allVisuals().last()
    policia.tomarArma(new Escopeta())
    policia.disparar()
    const proyectilDeEscopeta = game.allVisuals().last()

    assert.equals(1, proyectilDePistola.danioProyectil())
    assert.equals(2, proyectilDeEscopeta.danioProyectil())
    proyectilDePistola.destruir()
    proyectilDeEscopeta.destruir()
  }

  test "no se puede disparar mientras el arma esta en cooldown" {
    policia.tomarArma(new Pistola())
    policia.disparar()
    const proyectil = game.allVisuals().last()

    assert.throwsExceptionWithMessage("No se puede disparar", { policia.disparar() })
    proyectil.destruir()
  }

  test "la pared destruye el proyectil que la golpea" {
    const proyectil = new Proyectil(position = game.at(4, 4), direccion = arriba, danioProyectil = 1)
    game.addVisual(proyectil)

    new Pared().recibirImpactoDe(proyectil)

    assert.notThat(game.hasVisual(proyectil))
  }
}
